rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each learner has one document, users/{their uid}, that only they can read or write.
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['s', 'upd', 'at'])
        && request.resource.data.s is string
        && request.resource.data.s.size() < 900000
        && request.resource.data.upd is number;
    }
    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
