rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each learner's progress: users/{their uid}, readable and writable only by them.
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      // s/upd = Japanese course, d/du = German course, m/mu = Marathi course
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['s', 'upd', 'd', 'du', 'm', 'mu', 'at'])
        && (!('s' in request.resource.data) || (request.resource.data.s is string && request.resource.data.s.size() < 900000))
        && (!('d' in request.resource.data) || (request.resource.data.d is string && request.resource.data.d.size() < 900000))
        && (!('m' in request.resource.data) || (request.resource.data.m is string && request.resource.data.m.size() < 900000))
        && (!('upd' in request.resource.data) || request.resource.data.upd is number)
        && (!('du' in request.resource.data) || request.resource.data.du is number)
        && (!('mu' in request.resource.data) || request.resource.data.mu is number);
    }
    // Each learner's reminder settings: reminders/{their uid}. lastSent is written only by the server job.
    match /reminders/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['token', 'tz', 'hour', 'on', 'at', 'lastSent'])
        && request.resource.data.token is string && request.resource.data.token.size() < 4096
        && request.resource.data.tz is string && request.resource.data.tz.size() < 64
        && request.resource.data.hour is int && request.resource.data.hour >= 0 && request.resource.data.hour <= 23
        && request.resource.data.on is bool;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
